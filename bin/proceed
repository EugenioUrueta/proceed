      if (e.key === 'Escape' || e.key === 'q' || e.key === 'Q') {{
        window.close();
      }}
    }});
  </script>
</body>
</html>"""


def open_mermaid_viewer(file_path):
    """
    Extracts all Mermaid diagrams from file_path, generates the HTML view,
    and opens it asynchronously in the user's default browser.
    Returns True if diagrams were found and opened, False otherwise.
    """
    diagrams = extract_mermaid_diagrams(file_path)
    if not diagrams:
        base = os.path.basename(file_path) if file_path else "documento"
        print(f"\n\x1b[33m[!] El archivo '{base}' no contiene bloques de diagramas Mermaid (```mermaid).\x1b[0m")
        return False

    base_name = os.path.basename(file_path) if file_path else "plan"
    mtime = os.path.getmtime(file_path) if os.path.exists(file_path) else 0
    safe_name = re.sub(r"[^a-zA-Z0-9_-]", "_", base_name)
    h = hashlib.md5(f"{file_path}_{mtime}".encode("utf-8")).hexdigest()[:8]
    tmp_path = os.path.join(tempfile.gettempdir(), f"proceed_{safe_name}_{h}.html")

    html_content = generate_mermaid_html(file_path, diagrams)
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            f.write(html_content)
    except Exception as e:
        print(f"\n\x1b[31m[!] Error al generar vista HTML: {e}\x1b[0m")
        return False

    try:
        if sys.platform == "darwin":
            subprocess.Popen(["open", tmp_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(["xdg-open", tmp_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"\n\x1b[32m✓ {len(diagrams)} diagrama(s) Mermaid abierto(s) en tu navegador.\x1b[0m")
        print(f"\x1b[2m  Vista HTML: {tmp_path}\x1b[0m\n")
        return True
    except Exception as e:
        print(f"\n\x1b[31m[!] Error al abrir navegador: {e}\x1b[0m")
        print(f"\x1b[2m  Puedes abrir manualmente: {tmp_path}\x1b[0m\n")
        return False



def get_single_key(prompt=""):
    """
    Reads a single keypress in raw terminal mode without requiring Enter.
    Returns:
      'esc' for standalone Escape key (\x1b)
      'enter' for Enter key (\r or \n)
      'q' for 'q' or 'Q'
      'esc_seq' for arrow keys / escape sequences
      single lowercase character for other keys
    """
    if prompt:
        sys.stdout.write(prompt)
        sys.stdout.flush()

    if not sys.stdin.isatty():
        try:
            line = sys.stdin.readline()
            return line.strip().lower()
        except Exception:
            return "esc"

    fd = sys.stdin.fileno()
    try:
        termios.tcflush(fd, termios.TCIFLUSH)
    except Exception:
        pass

    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == "\x1b":
            # Check if there are following characters within 50ms (arrow keys, etc.)
            r, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r:
                sys.stdin.read(2)  # consume escape sequence
                return "esc_seq"
            return "esc"
        elif ch in ("\r", "\n"):
            return "enter"
        elif ch in ("\x03", "\x04", "\x1a"):  # Ctrl+C, Ctrl+D, Ctrl+Z
            return "esc"
        elif ch in ("q", "Q"):
            return "q"
        return ch.lower()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


def get_herdr_snapshot():
    """Queries live session snapshot from Herdr daemon."""
    if os.environ.get("HERDR_ENV") != "1":
        return None
    try:
        res = subprocess.run(
            ["herdr", "api", "snapshot"],
            capture_output=True,
            text=True,
            timeout=3,
        )
        if res.returncode == 0:
            data = json.loads(res.stdout)
            return data.get("result", {}).get("snapshot", {})
    except Exception:
        pass
    return None


def get_session_markdown_artifacts(directory):
    """
    Returns all markdown artifacts in an agy brain directory sorted descending by mtime.
    Includes plans, walkthroughs, and any documentation generated in the session.
    """
    if not directory or not os.path.isdir(directory):
        return []

    items = []
    for f in glob.glob(os.path.join(directory, "*.md")):
        base = os.path.basename(f)
        if base.startswith("."):
            continue

        try:
            mtime = os.path.getmtime(f)
            size_bytes = os.path.getsize(f)
        except OSError:
            continue

        dt = datetime.datetime.fromtimestamp(mtime)
        time_str = dt.strftime("%H:%M")

        if size_bytes < 1024:
            size_str = f"{size_bytes} B"
        else:
            size_str = f"{size_bytes / 1024:.1f} KB"

        summary = ""
        request_feedback = False
        meta_path = f + ".metadata.json"
        if os.path.exists(meta_path):
            try:
                with open(meta_path, "r", encoding="utf-8") as mf:
                    mdata = json.load(mf)
                    summary = mdata.get("summary", "").strip()
                    request_feedback = mdata.get("requestFeedback") is True
            except Exception:
                pass

        is_walkthrough = base.lower().startswith("walkthrough")
        is_plan = base.lower().startswith("plan") or request_feedback
        mermaid_count = count_mermaid_diagrams(f)

        items.append({
            "path": f,
            "filename": base,
            "mtime": mtime,
            "time_str": time_str,
            "size_str": size_str,
            "summary": summary,
            "is_plan": is_plan,
            "is_walkthrough": is_walkthrough,
            "request_feedback": request_feedback,
            "mermaid_count": mermaid_count,
        })

    # Sort descending by modification time (most recent first)
    items.sort(key=lambda x: x["mtime"], reverse=True)
    return items


def get_pi_markdown_artifacts(directory):
    """
    Returns markdown artifacts for a pi agent working in directory.
    Searches directory/*.md and common plan subdirectories (.plans/*.md, plans/*.md, etc.),
    sorted descending by mtime.
    """
    if not directory or not os.path.isdir(directory):
        return []

    patterns = [
        os.path.join(directory, "*.md"),
        os.path.join(directory, ".plans", "*.md"),
        os.path.join(directory, "plans", "*.md"),
        os.path.join(directory, ".pi", "plans", "*.md"),
        os.path.join(directory, ".pi", "*.md"),
        os.path.join(directory, ".agent", "plans", "*.md"),
        os.path.join(directory, "docs", "plans", "*.md"),
    ]

    seen = set()
    items = []

    for pat in patterns:
        for f in glob.glob(pat):
            abs_path = os.path.abspath(f)
            if abs_path in seen:
                continue
            seen.add(abs_path)

            base = os.path.basename(f)
            # Skip hidden files directly, but allow files inside folders like .plans/
            if base.startswith("."):
                continue

            try:
                mtime = os.path.getmtime(f)
                size_bytes = os.path.getsize(f)
            except OSError:
                continue

            dt = datetime.datetime.fromtimestamp(mtime)
            time_str = dt.strftime("%H:%M")

            if size_bytes < 1024:
                size_str = f"{size_bytes} B"
            else:
                size_str = f"{size_bytes / 1024:.1f} KB"

            # Display relative filename if inside directory, e.g. .plans/plan.md or plan.md
            try:
                rel_name = os.path.relpath(f, directory)
            except Exception:
                rel_name = base

            summary = ""
            request_feedback = False
            meta_path = f + ".metadata.json"
            if os.path.exists(meta_path):
                try:
                    with open(meta_path, "r", encoding="utf-8") as mf:
                        mdata = json.load(mf)
                        summary = mdata.get("summary", "").strip()
                        request_feedback = mdata.get("requestFeedback") is True
                except Exception:
                    pass

            if not summary and os.path.exists(f):
                try:
                    with open(f, "r", encoding="utf-8", errors="replace") as doc_f:
                        for line in doc_f:
                            s = line.strip()
                            if s.startswith("#"):
                                summary = s.lstrip("#").strip()
                                break
                            elif s:
                                summary = s
                                break
                    if summary.strip().lower() == base.strip().lower():
                        summary = ""
                    elif len(summary) > 120:
                        summary = summary[:117] + "..."
                except Exception:
                    pass

            is_walkthrough = base.lower().startswith("walkthrough")
            is_plan = (
                base.lower().startswith("plan")
                or "plan" in base.lower()
                or "/.plans/" in f
                or "/plans/" in f
                or request_feedback
            )
            mermaid_count = count_mermaid_diagrams(f)

            items.append({
                "path": f,
                "filename": rel_name,
                "mtime": mtime,
                "time_str": time_str,
                "size_str": size_str,
                "summary": summary,
                "is_plan": is_plan,
                "is_walkthrough": is_walkthrough,
                "request_feedback": request_feedback,
                "mermaid_count": mermaid_count,
            })

    items.sort(key=lambda x: x["mtime"], reverse=True)
    return items


def find_latest_artifacts_global():
    """Fallback: finds recent markdown artifacts across all brain directories."""
    candidates = []
    if os.path.isdir(BRAIN_ROOT):
        pattern = os.path.join(BRAIN_ROOT, "*", "*.md")
        for f in glob.glob(pattern):
            base = os.path.basename(f)
            if base.startswith("."):
                continue
            candidates.append(f)
    if not candidates:
        return []

    items = []
    for f in candidates:
        try:
            mtime = os.path.getmtime(f)
            size_bytes = os.path.getsize(f)
        except OSError:
            continue
        base = os.path.basename(f)
        dt = datetime.datetime.fromtimestamp(mtime)
        mermaid_count = count_mermaid_diagrams(f)
        items.append({
            "path": f,
            "filename": base,
            "mtime": mtime,
            "time_str": dt.strftime("%H:%M"),
            "size_str": f"{size_bytes / 1024:.1f} KB" if size_bytes >= 1024 else f"{size_bytes} B",
            "summary": "",
            "is_plan": base.lower().startswith("plan") or "plan" in base.lower(),
            "is_walkthrough": base.lower().startswith("walkthrough"),
            "request_feedback": False,
            "mermaid_count": mermaid_count,
        })
    items.sort(key=lambda x: x["mtime"], reverse=True)
    return items[:10]


def get_tab_label(snapshot, tab_id):
    """Gets human-readable label for a tab."""
    if not snapshot or not tab_id:
        return ""
    for t in snapshot.get("tabs", []):
        if t.get("tab_id") == tab_id:
            label = t.get("label", "")
            num = t.get("number", "")
            return f"[{num}] {label}" if label else f"Tab {num or tab_id}"
    return tab_id


def resolve_agy_agent(snapshot):
    """Accurately resolves which agy or pi agent the user is working with."""
    if not snapshot:
        return None

    agents = [a for a in snapshot.get("agents", []) if a.get("agent") in ("agy", "pi")]
    if not agents:
        return None

    if len(agents) == 1:
        return agents[0]

    caller_pane_id = os.environ.get("HERDR_PANE_ID")
    focused_pane_id = snapshot.get("focused_pane_id")
    focused_tab_id = snapshot.get("focused_tab_id")
    cwd = os.getcwd()

    invoked_name = os.path.basename(sys.argv[0]).lower()
    preferred_agent = "pi" if "pi" in invoked_name else ("agy" if "agy" in invoked_name else None)

    # 1. Direct caller pane match (running inside an agent terminal pane)
    if caller_pane_id:
        for a in agents:
            if a.get("pane_id") == caller_pane_id:
                return a

    # 2. Focused pane match (modal popup triggered via prefix+p over focused agent pane)
    if focused_pane_id:
        for a in agents:
            if a.get("pane_id") == focused_pane_id:
                return a

    # 3. Focused tab match
    if focused_tab_id:
        tab_agents = [a for a in agents if a.get("tab_id") == focused_tab_id]
        if len(tab_agents) == 1:
            return tab_agents[0]
        elif len(tab_agents) > 1:
            if preferred_agent:
                pref_matches = [a for a in tab_agents if a.get("agent") == preferred_agent]
                if len(pref_matches) == 1:
                    return pref_matches[0]
            for a in tab_agents:
                agent_cwd = a.get("cwd")
                if agent_cwd and os.path.abspath(agent_cwd) == os.path.abspath(cwd):
                    return a
            agents = tab_agents

    # 4. Match cwd
    cwd_matches = [a for a in agents if a.get("cwd") and os.path.abspath(a.get("cwd")) == os.path.abspath(cwd)]
    if len(cwd_matches) == 1:
        return cwd_matches[0]
    elif len(cwd_matches) > 1:
        if preferred_agent:
            pref_matches = [a for a in cwd_matches if a.get("agent") == preferred_agent]
            if len(pref_matches) == 1:
                return pref_matches[0]
        agents = cwd_matches

    # 5. Interactive picker if multiple candidates remain
    print("\n\x1b[1;36m🔍 Múltiples agentes detectados en Herdr:\x1b[0m")
    options = []
    for idx, a in enumerate(agents, 1):
        pid = a.get("pane_id", "")
        tid = a.get("tab_id", "")
        tab_label = get_tab_label(snapshot, tid)
        a_cwd = a.get("cwd", "")
        a_type = a.get("agent", "agy")
        sess = a.get("agent_session", {}).get("value", "")

        if a_type == "pi":
            artifacts = get_pi_markdown_artifacts(a_cwd) if a_cwd else []
        else:
            artifacts = get_session_markdown_artifacts(os.path.join(BRAIN_ROOT, sess)) if sess else []
        latest_name = artifacts[0]["filename"] if artifacts else "Sin documentos"

        agent_badge = f"\x1b[1;35m{a_type}\x1b[0m"
        print(f"  \x1b[1;33m[{idx}]\x1b[0m \x1b[1m{tab_label}\x1b[0m (Pane: {pid} • Agente: {agent_badge})")
        print(f"      Carpeta: {a_cwd}")
        print(f"      Último doc: \x1b[32m{latest_name}\x1b[0m\n")
        options.append(a)

    prompt_str = f"\x1b[1mSelecciona agente [1-{len(options)}] (Enter=1, Esc/q=Salir): \x1b[0m"
    key = get_single_key(prompt_str)
    print()

    if key in ("esc", "q"):
        return None
    if key == "enter":
        return options[0]
    if key.isdigit() and 1 <= int(key) <= len(options):
        return options[int(key) - 1]

    return options[0]


def resolve_session_artifacts(explicit_path=None):
    """Resolves all available markdown artifacts for the active session."""
    snapshot = get_herdr_snapshot()
    agent = resolve_agy_agent(snapshot)

    pane_id = agent.get("pane_id") if agent else None
    agent_type = agent.get("agent", "agy") if agent else "agy"
    sess_id = agent.get("agent_session", {}).get("value") if agent else None
    tab_id = agent.get("tab_id") if agent else None
    tab_label = get_tab_label(snapshot, tab_id) if agent else ""
    agent_cwd = agent.get("cwd", "") if agent else os.getcwd()

    short_sess = ""
    if sess_id:
        if agent_type == "pi":
            base_s = os.path.basename(sess_id).replace(".jsonl", "")
            short_sess = base_s.split("_")[-1][:8] if "_" in base_s else base_s[:8]
        else:
            short_sess = sess_id[:8]

    meta = {
        "pane_id": pane_id,
        "agent": agent_type,
        "session_id": sess_id,
        "short_session": short_sess,
        "tab_id": tab_id,
        "tab_label": tab_label,
        "cwd": agent_cwd,
    }

    if explicit_path:
        base = os.path.basename(explicit_path)
        abs_p = os.path.abspath(explicit_path)
        items = [{
            "path": abs_p,
            "filename": base,
            "mtime": os.path.getmtime(abs_p) if os.path.exists(abs_p) else 0,
            "time_str": "",
            "size_str": "",
            "summary": "",
            "is_plan": base.lower().startswith("plan") or "plan" in base.lower(),
            "is_walkthrough": base.lower().startswith("walkthrough"),
            "request_feedback": False,
            "mermaid_count": count_mermaid_diagrams(abs_p),
        }]
        return items, meta

    if agent_type == "pi":
        artifacts = get_pi_markdown_artifacts(agent_cwd)
        if not artifacts and os.path.abspath(os.getcwd()) != os.path.abspath(agent_cwd):
            artifacts = get_pi_markdown_artifacts(os.getcwd())
        if artifacts:
            return artifacts, meta

    elif agent_type == "agy":
        if sess_id:
            conv_dir = os.path.join(BRAIN_ROOT, sess_id)
            artifacts = get_session_markdown_artifacts(conv_dir)
            if artifacts:
                return artifacts, meta

    return find_latest_artifacts_global(), meta


def select_artifact_from_list(artifacts, meta):
    """Presents descending list of artifacts and returns the chosen item dict."""
    if not artifacts:
        return None

    if len(artifacts) == 1:
        return artifacts[0]

    agent_type = meta.get("agent", "agy")
    short_sess = meta.get("short_session") or "global"
    tab_info = f" • Pestaña: {meta['tab_label']}" if meta.get("tab_label") else ""

    print("\n\x1b[1;36m" + "=" * 68 + "\x1b[0m")
    print(f"\x1b[1m📂 Documentos Markdown de la sesión [{agent_type}:{short_sess}]{tab_info}:\x1b[0m")
    print("\x1b[1;36m" + "─" * 68 + "\x1b[0m")

    for idx, a in enumerate(artifacts, 1):
        icon = "📄"
        tag = ""
        if a["is_walkthrough"]:
            icon = "🏆"
            tag = " \x1b[1;32m[Walkthrough / Resumen]\x1b[0m"
        elif a["request_feedback"]:
            icon = "📋"
            tag = " \x1b[1;33m[Requiere Aprobación]\x1b[0m"
        elif a["is_plan"]:
            icon = "📋"
            tag = " \x1b[2m[Plan]\x1b[0m"

        latest_badge = " \x1b[1;36m[Más reciente]\x1b[0m" if idx == 1 else ""
        diag_count = a.get("mermaid_count", 0)
        diag_badge = f" \x1b[1;35m[📊 {diag_count} diag]\x1b[0m" if diag_count > 0 else ""

        print(f"  \x1b[1;33m[{idx}]\x1b[0m {icon} \x1b[1m{a['filename']}\x1b[0m \x1b[2m({a['time_str']} • {a['size_str']})\x1b[0m{tag}{diag_badge}{latest_badge}")
        if a.get("summary"):
            print(f"      \x1b[2m{a['summary']}\x1b[0m")
        print()

    print("\x1b[1;36m" + "=" * 68 + "\x1b[0m")

    num_items = len(artifacts)
    has_diagrams_any = any(a.get("mermaid_count", 0) > 0 for a in artifacts)
    m_hint = ", m=Diagramas" if has_diagrams_any else ""
    prompt_str = f"\x1b[1mSelecciona [1-{num_items}] (Enter=1{m_hint}, Esc/q=Salir): \x1b[0m"

    while True:
        key = get_single_key(prompt_str)
        print()

        if key in ("esc", "q"):
            return None

        if key == "enter":
            return artifacts[0]

        if key in ("m", "mermaid"):
            # Open diagrams for the first document that has diagrams, or default to artifacts[0]
            target = None
            for item in artifacts:
                if item.get("mermaid_count", 0) > 0:
                    target = item
                    break
            if not target:
                target = artifacts[0]
            open_mermaid_viewer(target["path"])
            continue

        if key.isdigit():
            val = int(key)
            if 1 <= val <= num_items:
                return artifacts[val - 1]

        print(f"\x1b[33mOpción '{key}' no válida. Pulsa 1..{min(num_items, 9)}, Enter, m, o Esc/q para salir.\x1b[0m")


def send_to_agent(pane_id, text, agent_type="agy"):
    """Sends command or text to the target agent pane in Herdr."""
    if not pane_id:
        print(f"\n\x1b[33m[!] No se pudo determinar el pane de {agent_type}.\x1b[0m")
        return False
    try:
        cmd = ["herdr", "pane", "run", pane_id, text]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return res.returncode == 0
    except Exception as e:
        print(f"\n\x1b[31mError al comunicar con Herdr: {e}\x1b[0m")
        return False


def send_to_agy(pane_id, text):
    """Compatibility wrapper for send_to_agent."""
    return send_to_agent(pane_id, text, "agy")


def view_markdown(file_path):
    """
    Renders markdown file using available viewers in priority cascade:
      1. leaf: Native terminal Mermaid diagrams, interactive TOC, full-text search, mouse scroll.
      2. glow: Formatted ANSI markdown with injected diagram banner.
      3. less: Standard fallback pager.
    Can be overridden via PROCEED_VIEWER environment variable ('leaf', 'glow', 'less').
    """
    preferred_viewer = os.environ.get("PROCEED_VIEWER", "").strip().lower()

    leaf_bin = shutil.which("leaf")
    glow_bin = shutil.which("glow")

    # Priority 1: Leaf (if available and not explicitly disabled)
    if leaf_bin and (not preferred_viewer or preferred_viewer == "leaf"):
        try:
            subprocess.run([leaf_bin, file_path])
            return
        except Exception:
            pass

    # Priority 2: Glow (with diagram tip banner and lesskey exit)
    if glow_bin and (not preferred_viewer or preferred_viewer == "glow"):
        env = os.environ.copy()
        env["LESSKEY_CONTENT"] = "#command\n\\e quit\nq quit\nQ quit\n"
        env["LESS"] = env.get("LESS", "") + " -R -K"

        render_path = file_path
        tmp_annotated = None
        diag_count = count_mermaid_diagrams(file_path)
        if diag_count > 0:
            try:
                with open(file_path, "r", encoding="utf-8", errors="replace") as f:
                    content = f.read()

                plural = "s" if diag_count != 1 else ""
                banner = (
                    f"> [!TIP]\n"
                    f"> 📊 **Este documento contiene {diag_count} diagrama{plural} Mermaid interactivo{plural}**.\n"
                    f"> Presiona **`q`** o **`Esc`** para salir de este lector y pulsa **`m`** en la terminal para verlos en tu navegador.\n\n"
                )

                tmp_annotated = os.path.join(
                    tempfile.gettempdir(),
                    f"proceed_view_{os.path.basename(file_path)}"
                )
                with open(tmp_annotated, "w", encoding="utf-8") as tf:
                    tf.write(banner + content)
                render_path = tmp_annotated
            except Exception:
                render_path = file_path

        try:
            subprocess.run([glow_bin, "-p", render_path], env=env)
            return
        finally:
            if tmp_annotated and os.path.exists(tmp_annotated):
                try:
                    os.remove(tmp_annotated)
                except Exception:
                    pass

    # Priority 3: Fallback pager (less)
    env = os.environ.copy()
    env["LESSKEY_CONTENT"] = "#command\n\\e quit\nq quit\nQ quit\n"
    env["LESS"] = env.get("LESS", "") + " -R -K"
    subprocess.run(["less", "-R", file_path], env=env)


def main():
    import argparse

    parser = argparse.ArgumentParser(
        description="proceed: Revisa y aprueba documentos Markdown (.md) de agentes de IA (agy, pi) en terminal."
    )
    parser.add_argument("file", nargs="?", help="Ruta opcional a un archivo .md")
    parser.add_argument(
        "--list", action="store_true", help="Lista los documentos Markdown de la sesión y sale"
    )
    parser.add_argument(
        "--path", action="store_true", help="Imprime solo la ruta del documento más reciente"
    )
    parser.add_argument(
        "--approve", action="store_true", help="Aprueba directamente enviando 'Proceed'"
    )
    parser.add_argument(
        "--copy", action="store_true", help="Copia el documento actual a la carpeta de trabajo"
    )
    parser.add_argument(
        "-m", "--mermaid", action="store_true", help="Extrae y visualiza los diagramas Mermaid en el navegador"
    )
    parser.add_argument(
        "--viewer", choices=["leaf", "glow", "less"], help="Fuerza el visor de Markdown (leaf, glow, less)"
    )

    args = parser.parse_args()

    if args.viewer:
        os.environ["PROCEED_VIEWER"] = args.viewer

    artifacts, meta = resolve_session_artifacts(args.file)
    pane_id = meta.get("pane_id")
    agent_type = meta.get("agent", "agy")

    if not artifacts:
        print("\x1b[31m[!] No se encontraron documentos Markdown recientes para esta sesión.\x1b[0m")
        sys.exit(1)

    if args.mermaid:
        top = artifacts[0]
        if not open_mermaid_viewer(top["path"]):
            sys.exit(1)
        sys.exit(0)

    if args.list:
        tab_info = f" • {meta['tab_label']}" if meta.get("tab_label") else ""
        print(f"\n\x1b[1m📂 Documentos de la sesión [{agent_type}]{tab_info} ({len(artifacts)} disponibles):\x1b[0m")
        for idx, a in enumerate(artifacts, 1):
            tag = " [Requiere Aprobación]" if a["request_feedback"] else (" [Walkthrough]" if a["is_walkthrough"] else (" [Plan]" if a["is_plan"] else ""))
            diag_str = f" [📊 {a.get('mermaid_count', 0)} diag]" if a.get("mermaid_count", 0) > 0 else ""
            print(f"  [{idx}] {a['filename']} ({a['time_str']} - {a['size_str']}){tag}{diag_str}")
            if a.get("summary"):
                print(f"      {a['summary']}")
        sys.exit(0)

    if args.path:
        print(artifacts[0]["path"])
        sys.exit(0)

    if args.copy:
        top = artifacts[0]
        dest = os.path.abspath(top["filename"])
        shutil.copyfile(top["path"], dest)
        print(f"\x1b[32m✓ Documento copiado a: {dest}\x1b[0m")
        sys.exit(0)

    if args.approve:
        if pane_id:
            if send_to_agent(pane_id, "Proceed", agent_type):
                print(f"\x1b[32m✓ Aprobación enviada a {agent_type} en {pane_id} (Proceed).\x1b[0m")
                sys.exit(0)
            else:
                sys.exit(1)
        else:
            print(f"\x1b[31m[!] No se encontró un pane de {agent_type} activo para enviar 'Proceed'.\x1b[0m")
            sys.exit(1)

    # Interactive flow
    current_item = None
    while True:
        # Prompt selection if not selected yet or if user requested list
        if not current_item:
            current_item = select_artifact_from_list(artifacts, meta)
            if not current_item:
                # User pressed Esc or q in the list -> exit immediately
                sys.exit(0)

        doc_path = current_item["path"]
        if not os.path.exists(doc_path):
            print(f"\x1b[31m[!] El archivo {doc_path} ya no existe.\x1b[0m")
            current_item = None
            continue

        # View with glow (Esc or q quits reader cleanly)
        view_markdown(doc_path)

        # Context-aware post-viewing action:
        diag_count = current_item.get("mermaid_count", 0)
        if diag_count == 0:
            diag_count = count_mermaid_diagrams(doc_path)

        is_plan_doc = current_item.get("request_feedback") or current_item.get("is_plan")
        has_diagrams = diag_count > 0

        # If informational (walkthrough/notes) without diagrams, exit immediately
        if not is_plan_doc and not has_diagrams:
            sys.exit(0)

        # If informational (walkthrough/notes) but HAS diagrams, offer viewing diagrams
        if not is_plan_doc and has_diagrams:
            print("\n\x1b[1;36m" + "=" * 68 + "\x1b[0m")
            print(f"  \x1b[1m🏆 {current_item['filename']}\x1b[0m \x1b[2m({current_item.get('time_str', '')})\x1b[0m")
            print("\x1b[1;36m" + "─" * 68 + "\x1b[0m")
            diag_btn = f"  \x1b[1;35m[m]\x1b[0m Ver diagramas ({diag_count})"
            if len(artifacts) > 1:
                print(f"{diag_btn}       \x1b[1;36m[l]\x1b[0m Ver lista de docs")
                print("  \x1b[1;31m[Esc / q / Enter]\x1b[0m Salir")
            else:
                print(f"{diag_btn}       \x1b[1;31m[Esc / q / Enter]\x1b[0m Salir")
            print("\x1b[1;36m" + "=" * 68 + "\x1b[0m")

            prompt_action = "\x1b[1mAcción: \x1b[0m"
            key = get_single_key(prompt_action)
            print()

            if key in ("esc", "q", "enter"):
                print("\x1b[2mSaliendo sin acciones.\x1b[0m")
                sys.exit(0)
            elif key in ("m", "mermaid", "diagramas"):
                open_mermaid_viewer(doc_path)
                continue
            elif key in ("l", "lista"):
                current_item = None
                continue
            elif key in ("o", "open"):
                editor = os.environ.get("EDITOR", "nvim")
                subprocess.run([editor, doc_path])
                sys.exit(0)
            elif key in ("c", "copy"):
                dest = os.path.abspath(current_item["filename"])
                shutil.copyfile(doc_path, dest)
                print(f"\x1b[32m✓ Copia guardada en: {dest}\x1b[0m")
                sys.exit(0)
            else:
                sys.exit(0)

        # If it is a plan requiring feedback/approval:
        print("\n\x1b[1;36m" + "=" * 68 + "\x1b[0m")
        print(f"  \x1b[1m📋 Plan:\x1b[0m {current_item['filename']}")
        if pane_id:
            tab_info = f" • Pestaña: {meta['tab_label']}" if meta.get("tab_label") else ""
            sess_str = f" • Sesión: {meta.get('short_session')}" if meta.get("short_session") else ""
            print(f"  \x1b[2m🎯 Pane de {agent_type}: {pane_id}{tab_info}{sess_str}\x1b[0m")
        print("\x1b[1;36m" + "─" * 68 + "\x1b[0m")
        print("  \x1b[1;32m[a]\x1b[0m Aprobar (Proceed)       \x1b[1;33m[f]\x1b[0m Enviar feedback")
        if diag_count > 0:
            diag_btn = f"  \x1b[1;35m[m]\x1b[0m Ver diagramas ({diag_count})"
            if len(artifacts) > 1:
                print(f"{diag_btn}       \x1b[1;36m[l]\x1b[0m Ver lista de docs")
                print("  \x1b[1;31m[Esc / q / Enter]\x1b[0m Salir sin acción")
            else:
                print(f"{diag_btn}       \x1b[1;31m[Esc / q / Enter]\x1b[0m Salir sin acción")
        else:
            if len(artifacts) > 1:
                print("  \x1b[1;36m[l]\x1b[0m Ver lista de docs       \x1b[1;31m[Esc / q / Enter]\x1b[0m Salir sin acción")
            else:
                print("  \x1b[1;31m[Esc / q / Enter]\x1b[0m Salir sin acción")
        print("\x1b[1;36m" + "=" * 68 + "\x1b[0m")

        prompt_action = "\x1b[1mAcción: \x1b[0m"
        key = get_single_key(prompt_action)
        print()

        # Immediate exit without performing any action on Esc, q, or Enter
        if key in ("esc", "q", "enter"):
            print("\x1b[2mSaliendo sin acciones.\x1b[0m")
            sys.exit(0)

        if key in ("a", "aprobar"):
            if pane_id:
                if send_to_agent(pane_id, "Proceed", agent_type):
                    print(f"\x1b[32m✓ Aprobación enviada a {agent_type} en {pane_id} (Proceed).\x1b[0m\n")
                    import time
                    time.sleep(1)
                    sys.exit(0)
                else:
                    print("\x1b[31mNo se pudo enviar la aprobación.\x1b[0m")
                    sys.exit(1)
            else:
                print(f"\x1b[33mNo se detectó el pane de {agent_type}.\x1b[0m")
                sys.exit(1)

        elif key in ("m", "mermaid", "diagramas"):
            open_mermaid_viewer(doc_path)
            continue

        elif key in ("l", "lista"):
            current_item = None
            continue

        elif key in ("f", "feedback"):
            try:
                feedback = input(f"\n\x1b[1mEscribe tus comentarios para {agent_type}:\x1b[0m ").strip()
            except (KeyboardInterrupt, EOFError):
                sys.exit(0)
            if feedback and pane_id:
                if send_to_agent(pane_id, feedback, agent_type):
                    print(f"\x1b[32m✓ Feedback enviado a {agent_type} en {pane_id}.\x1b[0m\n")
                    import time
                    time.sleep(1)
                    sys.exit(0)
            sys.exit(0)

        elif key in ("o", "open"):
            editor = os.environ.get("EDITOR", "nvim")
            subprocess.run([editor, doc_path])
            sys.exit(0)

        elif key in ("c", "copy"):
            dest = os.path.abspath(current_item["filename"])
            shutil.copyfile(doc_path, dest)
            print(f"\x1b[32m✓ Copia guardada en: {dest}\x1b[0m")
            sys.exit(0)
        else:
            print("\x1b[2mSaliendo sin acciones.\x1b[0m")
            sys.exit(0)


if __name__ == "__main__":
    main()
