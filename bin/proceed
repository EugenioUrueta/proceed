#!/usr/bin/env python3
"""
proceed: Terminal-native Markdown viewer and approver for AI coding agents (agy, pi) in Herdr + Kitty.
Lists all session markdown artifacts (plans, walkthroughs) in descending order,
with instant preview, full Glow rendering, single-key Esc/q instant exit,
and context-aware quick approval/feedback actions.
"""

import sys
import os
import glob
import json
import shutil
import datetime
import subprocess
import termios
import tty
import select
import html
import re
import hashlib
import tempfile

BRAIN_ROOT = os.path.expanduser("~/.gemini/antigravity-cli/brain")
LOCAL_MERMAID_JS = os.path.expanduser("~/.local/share/proceed/mermaid.min.js")
CDN_MERMAID_JS = "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"


def extract_mermaid_diagrams(file_path):
    """
    Extracts all ```mermaid ... ``` code blocks from a markdown file.
    Associates each diagram with the nearest preceding heading.
    """
    if not file_path or not os.path.exists(file_path):
        return []

    diagrams = []
    current_heading = ""
    inside_mermaid = False
    current_lines = []

    try:
        with open(file_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                stripped = line.strip()
                if stripped.startswith("#"):
                    current_heading = stripped.lstrip("#").strip()

                if not inside_mermaid:
                    if stripped.startswith("```mermaid"):
                        inside_mermaid = True
                        current_lines = []
                else:
                    if stripped.startswith("```"):
                        inside_mermaid = False
                        code = "".join(current_lines).strip()
                        if code:
                            dtype = "diagram"
                            for c_line in code.splitlines():
                                cl = c_line.strip()
                                if cl and not cl.startswith("%%"):
                                    dtype = cl.split()[0]
                                    break
                            diagram_idx = len(diagrams) + 1
                            title = current_heading if current_heading else f"Diagrama {diagram_idx}"
                            diagrams.append({
                                "index": diagram_idx,
                                "title": title,
                                "code": code,
                                "diagram_type": dtype,
                            })
                    else:
                        current_lines.append(line)
    except Exception:
        pass

    return diagrams


def count_mermaid_diagrams(file_path):
    """Fast count of mermaid blocks in a markdown file."""
    if not file_path or not os.path.exists(file_path):
        return 0
    count = 0
    try:
        with open(file_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.strip().startswith("```mermaid"):
                    count += 1
    except Exception:
        pass
    return count


def generate_mermaid_html(file_path, diagrams):
    """
    Generates a standalone, dark-themed HTML document displaying all extracted
    Mermaid diagrams with interactive controls (copy, zoom, code toggle, jumping).
    Supports offline mode if ~/.local/share/proceed/mermaid.min.js is present.
    """
    base_name = os.path.basename(file_path) if file_path else "Plan"

    # Offline or CDN mermaid script
    mermaid_script = ""
    if os.path.exists(LOCAL_MERMAID_JS):
        try:
            with open(LOCAL_MERMAID_JS, "r", encoding="utf-8", errors="replace") as jf:
                inlined_js = jf.read()
            mermaid_script = f"<script>\n{inlined_js}\n</script>"
        except Exception:
            mermaid_script = f'<script src="{CDN_MERMAID_JS}"></script>'
    else:
        mermaid_script = f'<script src="{CDN_MERMAID_JS}"></script>'

    # Navigation items
    nav_links = []
    for d in diagrams:
        idx = d["index"]
        t = html.escape(d["title"][:28] + ("..." if len(d["title"]) > 28 else ""))
        nav_links.append(f'<a href="#card-{idx}" class="nav-chip">#{idx} {t}</a>')
    nav_html = f'<div class="nav-bar">{" ".join(nav_links)}</div>' if len(diagrams) > 1 else ""

    cards_html = []
    for d in diagrams:
        idx = d["index"]
        title_esc = html.escape(d["title"])
        code_raw = d["code"]
        code_esc = html.escape(code_raw)
        dtype_esc = html.escape(d["diagram_type"])

        card = f"""
    <div class="card" id="card-{idx}">
      <div class="card-header">
        <div class="card-title-group">
          <span class="badge-num">#{idx}</span>
          <span class="card-title">{title_esc}</span>
          <span class="badge-type">{dtype_esc}</span>
        </div>
        <div class="card-actions">
          <button class="btn btn-copy" onclick="copyMermaid({idx})">📋 Copiar</button>
          <button class="btn btn-zoom" onclick="zoomDiagram({idx}, 0.15)">🔍 +</button>
          <button class="btn btn-zoom" onclick="zoomDiagram({idx}, -0.15)">🔍 −</button>
          <button class="btn btn-reset" onclick="resetZoom({idx})">↺</button>
          <button class="btn btn-code" onclick="toggleCode({idx})">&lt;/&gt; Código</button>
        </div>
      </div>
      <div class="diagram-wrapper">
        <div class="diagram-zoom-target" id="zoom-target-{idx}">
          <pre class="mermaid" id="mermaid-{idx}">{code_esc}</pre>
        </div>
      </div>
      <div class="code-container" id="code-container-{idx}" style="display: none;">
        <pre><code id="raw-code-{idx}">{code_esc}</code></pre>
      </div>
    </div>
"""
        cards_html.append(card)

    cards_joined = "\n".join(cards_html)

    return f"""<!DOCTYPE html>
